# Server
PORT=3000

# Lock Polymarket moneyline % this close to tipoff (default 2 minutes)
# ODDS_LOCK_WINDOW_MS=120000
# ODDS_LOCK_GRACE_MS=60000

# Background poll interval (ESPN scores + Polymarket prices)
# SCORES_POLL_MS=15000
# SCORES_TTL_MS=15000

# Include pregame underdogs starting within this window (default 2 days)
# UPCOMING_HORIZON_MS=172800000

# Only keep games where the underdog's locked Polymarket win % is at or below this
# MAX_UNDERDOG_FAIR_PROB=0.42
