# Get a key at https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# Server
PORT=3000

# Optional: comma-separated The Odds API bookmaker keys (default draftkings)
# ODDS_BOOKMAKERS=draftkings

# Odds are fetched only inside this pre-tip window (default 10 minutes)
# ODDS_LOCK_WINDOW_MS=600000
# ODDS_LOCK_GRACE_MS=120000

# Background poll intervals
# SCORES_POLL_MS=30000
# ODDS_CHECK_MS=60000
# SCORES_TTL_MS=30000
